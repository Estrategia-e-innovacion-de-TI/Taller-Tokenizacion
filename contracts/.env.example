# Copia a .env y completa (make env).
# Nunca pongas la private key aquí: make deploy la pide de forma interactiva.

# RPC Ethereum Sepolia
#   https://sepolia.infura.io/v3/TU_KEY
#   https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan API key (verificación)
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Destinatario del capital de PropertySale (vacío = address del deployer)
TREASURY=
