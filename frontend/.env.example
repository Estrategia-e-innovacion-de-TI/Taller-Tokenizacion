VITE_BASE_PATH=/Taller-Tokenizacion/
# Email (Privy): lecturas HTTP de Sepolia. MetaMask usa el RPC de la billetera.
# Alchemy Sepolia: https://eth-sepolia.g.alchemy.com/v2/<API_KEY>
# No commitear la URL con key. En Pages va como secret VITE_SEPOLIA_RPC_URL.
VITE_SEPOLIA_RPC_URL=
VITE_PIMLICO_API_KEY=
# Dashboard Privy: App ID + login email + Allowed Origins (localhost y Pages).
VITE_PRIVY_APP_ID=
VITE_COPW_ADDRESS=
VITE_RENT_ADDRESS=
VITE_SALE_ADDRESS=
VITE_DISTRIBUTOR_ADDRESS=
